   "source": [
    "asset_drawdowns = {}\n",
    "\n",
    "for ticker in asset_growth.columns:\n",
    "    wealth = asset_growth[ticker]\n",
    "    peak = wealth.cummax()\n",
    "    drawdown = (wealth / peak) - 1\n",
    "    asset_drawdowns[ticker] = drawdown.min()\n",
    "\n",
    "asset_drawdowns[\"Equal-Weight Portfolio\"] = portfolio_drawdown.min()\n",
    "\n",
    "drawdown_comparison = pd.Series(\n",
    "    asset_drawdowns,\n",
    "    name=\"Maximum Drawdown\"\n",
    ")\n",
    "\n",
    "(drawdown_comparison * 100).round(2)"
