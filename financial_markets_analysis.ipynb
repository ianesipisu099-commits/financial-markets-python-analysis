    ")\n",
    "\n",
    "plt.axhline(0, linewidth=1)\n",
    "\n",
    "plt.title(\"Equal-Weight Portfolio Drawdown (2020–2025)\")\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Drawdown (%)\")\n",
    "plt.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"charts/portfolio_drawdown.png\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()"
